<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <script>
    (function() {
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <link rel="icon" href="/images/favicon.ico" sizes="any">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<script>
  function toggleTheme() {
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('theme', 'dark');
    }
  }
</script>
<div class="site">
  <header class="site-header">
    <div class="name-bar">
      <a href="/" class="site-name">{{ site.title }}</a>
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode"></button>
    </div>
    <div class="accent-seam"></div>
    <nav>
      <a href="/writing/"{% if page.url == "/writing/" %} aria-current="page"{% endif %}>Writing</a>
      <a href="/fiction/"{% if page.url == "/fiction/" %} aria-current="page"{% endif %}>Fiction</a>
      <a href="/games/"{% if page.url == "/games/" %} aria-current="page"{% endif %}>Games</a>
      <a href="/music/"{% if page.url == "/music/" %} aria-current="page"{% endif %}>Music</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <span>&copy; {{ site.title }}</span>
    <a href="https://github.com/codyloyd">Github</a>
  </footer>
</div>
</body>
</html>
